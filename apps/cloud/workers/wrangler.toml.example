name = "liteshop-cloud-api"
main = "src/index.js"
compatibility_date = "2025-01-01"

# Set these with `wrangler secret put`; do not put real values in this file.

[[d1_databases]]
binding = "DB"
database_name = "liteshop-cloud"
  # Replace the all-zero placeholder with the database_id from `wrangler d1 create`.
  database_id = "00000000-0000-0000-0000-000000000000"
